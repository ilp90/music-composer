# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173

AWS_REGION=us-east-1
# Local-only credentials: DynamoDB Local accepts anything; RustFS uses these as its root user (see docker-compose.yml).
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdev-secret

# Leave the *_ENDPOINT vars unset in AWS so the SDK uses the real service endpoints.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=app
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=recordings

# --- Auth ---
# ES256 private JWK (one line). Generate with: pnpm --filter @mc/api keys:generate >> apps/api/.env
# If unset outside production, an ephemeral key is used (sessions survive restarts; access tokens are silently refreshed).
# JWT_PRIVATE_JWK=
# Safari rejects Secure cookies on http://localhost; Chrome and Firefox accept them. Must be true in production.
COOKIE_SECURE=false
# Defaults: ACCESS_TOKEN_TTL_SECONDS=900, REFRESH_TOKEN_TTL_DAYS=30, BCRYPT_COST=12,
# LOGIN_MAX_FAILURES=10, LOGIN_FAILURE_WINDOW_SECONDS=900, COOKIE_PATH=/api/auth
